  <div class="proj-section">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Panel de administración: gestión de usuarios" data-en="Admin panel: user management">Panel de administración: gestión de usuarios</div>
    <div class="video-container">
      <video playsinline muted controls>
        <source src="/proyectos/apr-xativa/admin-usuarios.mp4" type="video/mp4" />
