          <img src="/proyectos/apr-xativa/flux_autenticacion_jwt.svg" alt="Diagrama" style="width:100%;display:block;border-radius:4px" />
        </div>
        <span class="diagram-label" data-es="Flujo de autenticación JWT · clic para ampliar" data-en="JWT authentication flow · click to enlarge">Flujo de autenticación JWT · clic para ampliar</span>
