<script>
  const ES = 'es'; const EN = 'en';
  let current = localStorage.getItem('lang') || ES;
  const btnEs = document.getElementById('btn-es');
  const btnEn = document.getElementById('btn-en');
  function applyLang(lang) {
    current = lang;
    localStorage.setItem('lang', lang);
    btnEs.className = lang === ES ? 'i18n-active' : 'i18n-inactive';
    btnEn.className = lang === EN ? 'i18n-active' : 'i18n-inactive';
    document.getElementById('html-root').lang = lang === ES ? 'es' : 'en';
    document.querySelectorAll('[data-es]').forEach(el => {
      const text = el.getAttribute(`data-${lang}`);
      if (text) el.innerHTML = text;
    });
  }
  btnEs.addEventListener('click', () => applyLang(ES));
  btnEn.addEventListener('click', () => applyLang(EN));
  applyLang(current);
</script>
</body>
