          <img src="/proyectos/apr-xativa/flux_solicitud_acceso.svg" alt="Diagrama" style="width:100%;display:block;border-radius:4px" />
        </div>
        <span class="diagram-label" data-es="Flujo de solicitud de acceso · clic para ampliar" data-en="Access request flow · click to enlarge">Flujo de solicitud de acceso · clic para ampliar</span>
      </div>
    </div>
  </div>

  <div class="section-divider"></div>

  <div class="proj-section">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Landing page informativa" data-en="Informational landing page">Landing page informativa</div>
    <div class="video-container">
      <video playsinline muted controls>
        <source src="/proyectos/apr-xativa/web-landing.mp4" type="video/mp4" />
