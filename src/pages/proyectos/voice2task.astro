<script>
  function makeGif(containerId, imgId, overlayId) {
    document.getElementById(containerId).addEventListener('click', function() {
      const img = document.getElementById(imgId);
      const overlay = document.getElementById(overlayId);
      if (overlay.classList.contains('hidden')) {
        img.src = img.getAttribute('data-still');
        overlay.classList.remove('hidden');
      } else {
        img.src = img.getAttribute('data-gif') + '?t=' + Date.now();
        overlay.classList.add('hidden');
      }
    });
  }
  makeGif('gif-audio','gif-audio-img','gif-audio-overlay');
  makeGif('gif-settings','gif-settings-img','gif-settings-overlay');
  makeGif('gif-cal','gif-cal-img','gif-cal-overlay');

  let appSlide = 0;
  const appSlides = document.querySelectorAll('#app-track .carousel-slide');
  const appDots = document.querySelectorAll('#app-dots .dot');
  function goToAppSlide(n) {
    appSlides[appSlide].classList.remove('active'); appDots[appSlide].classList.remove('active');
    appSlide = (n + appSlides.length) % appSlides.length;
    appSlides[appSlide].classList.add('active'); appDots[appSlide].classList.add('active');
  }
  document.getElementById('app-prev').addEventListener('click', () => goToAppSlide(appSlide - 1));
  document.getElementById('app-next').addEventListener('click', () => goToAppSlide(appSlide + 1));

  let webSlide = 0;
  const webSlides = document.querySelectorAll('#web-track .carousel-slide');
  const webDots = document.querySelectorAll('#web-dots .dot');
  function goToWebSlide(n) {
    webSlides[webSlide].classList.remove('active'); webDots[webSlide].classList.remove('active');
    webSlide = (n + webSlides.length) % webSlides.length;
    webSlides[webSlide].classList.add('active'); webDots[webSlide].classList.add('active');
  }
  document.getElementById('web-prev').addEventListener('click', () => goToWebSlide(webSlide - 1));
  document.getElementById('web-next').addEventListener('click', () => goToWebSlide(webSlide + 1));

  const ES='es',EN='en';
  let current=localStorage.getItem('lang')||ES;
  const btnEs=document.getElementById('btn-es'),btnEn=document.getElementById('btn-en');
  function applyLang(lang){current=lang;localStorage.setItem('lang',lang);btnEs.className=lang===ES?'i18n-active':'i18n-inactive';btnEn.className=lang===EN?'i18n-active':'i18n-inactive';document.getElementById('html-root').lang=lang===ES?'es':'en';document.querySelectorAll('[data-es]').forEach(el=>{const t=el.getAttribute(`data-${lang}`);if(t)el.innerHTML=t;});}
  btnEs.addEventListener('click',()=>applyLang(ES));
  btnEn.addEventListener('click',()=>applyLang(EN));
  applyLang(current);
</script>
