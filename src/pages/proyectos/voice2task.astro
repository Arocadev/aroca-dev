---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="es" id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Voice2Task · ArocaDev</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  <style>
    .section-divider{border-top:1px solid rgba(255,255,255,0.07);margin:80px 0}
    .proj-section{margin-bottom:72px}
    .proj-section-title{margin-bottom:24px}
    .diagram-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .diagram-item{border-radius:8px;overflow:hidden;cursor:pointer;border:1px solid rgba(255,255,255,0.07);background:#fff;padding:8px}
    .diagram-item object{width:100%;height:300px;display:block;pointer-events:none;border-radius:4px}
    .diagram-wrap{display:flex;flex-direction:column;align-items:center;gap:8px}
    .diagram-label{font-size:11px;color:var(--t4);text-align:center}
    .gif-container{position:relative;border-radius:8px;overflow:hidden;border:1px solid rgba(255,255,255,0.07);background:var(--bg2);cursor:pointer}
    .gif-container img{width:100%;display:block;border-radius:8px;max-height:760px;object-fit:cover;object-position:top}
    .gif-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;border-radius:8px;transition:opacity 0.2s}
    .gif-overlay.hidden{opacity:0;pointer-events:none}
    .gif-play-btn{width:64px;height:64px;border-radius:50%;background:rgba(129,140,248,0.9);display:flex;align-items:center;justify-content:center}
    .gif-play-btn svg{width:28px;height:28px;fill:#fff;margin-left:4px}
    .gif-label{font-size:11px;color:var(--t4);margin-bottom:20px;text-align:center}
    .carousel{position:relative;display:flex;align-items:center;gap:10px}
    .carousel-track{flex:1;overflow:hidden;border-radius:8px;border:1px solid rgba(255,255,255,0.07);background:var(--bg2)}
    .carousel-slide{display:none;flex-direction:column}
    .carousel-slide.active{display:flex}
    .carousel-slide img{width:100%;display:block;cursor:pointer;max-height:760px;object-fit:cover;object-position:top}
    .carousel-slide span{font-size:11px;color:var(--t4);padding:10px 14px;text-align:center;display:block}
    .carousel-btn{width:36px;height:36px;border-radius:50%;background:rgba(129,140,248,0.15);border:1px solid rgba(129,140,248,0.4);color:var(--ac);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background 0.2s}
    .carousel-btn:hover{background:rgba(129,140,248,0.3)}
    .carousel-dots{display:flex;justify-content:center;gap:6px;margin-top:12px}
    .dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,0.15);cursor:pointer;transition:background 0.2s}
    .dot.active{background:var(--ac)}
    .carousel-hint{font-size:11px;color:var(--t4);margin-bottom:16px;text-align:center}
    .mobile-carousel{justify-content:center}
    .carousel-track.mobile-track{flex:unset;width:300px;background:var(--bg2);border:1px solid rgba(255,255,255,0.07);border-radius:8px;overflow:hidden}
    .carousel-slide.mobile img{width:100%;max-height:500px;object-fit:contain;object-position:top;display:block;cursor:pointer}
    .gif-container.mobile-gif{width:300px;margin:0 auto}
    .gif-container.mobile-gif img{width:100%;max-height:500px;object-fit:contain;object-position:top;display:block;border-radius:8px}
  </style>
</head>
<body>
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">aroca<span>.dev</span></a>
    <div class="nav-r">
      <div class="nav-links">
        <a href="/#sobre-mi" data-es="sobre mí" data-en="about">sobre mí</a>
        <a href="/#proyectos" data-es="proyectos" data-en="projects">proyectos</a>
        <a href="/#experiencia" data-es="experiencia" data-en="experience">experiencia</a>
        <a href="/#contacto" data-es="contacto" data-en="contact">contacto</a>
        <a href="/#que-viene-ahora" data-es="próximo objetivo" data-en="next goal">próximo objetivo</a>
      </div>
      <div class="i18n">
        <span class="i18n-btn" id="btn-es">ES</span>
        <span class="i18n-sep">|</span>
        <span class="i18n-btn" id="btn-en">EN</span>
      </div>
    </div>
  </div>
</nav>

<div class="proj-hero">
  <div class="proj-category" data-es="Proyecto personal · Android + Backend + Web" data-en="Personal project · Android + Backend + Web">Proyecto personal · Android + Backend + Web</div>
  <div class="proj-title">Voice2Task</div>
  <div class="proj-subtitle" data-es="App Android que convierte notas de voz en tareas estructuradas con IA. Hablas, la IA entiende, y la tarea aparece en Voice2Task, Trello o Notion — donde quieras." data-en="Android app that converts voice notes into structured tasks using AI. You speak, the AI understands, and the task appears in Voice2Task, Trello or Notion — wherever you want.">App Android que convierte notas de voz en tareas estructuradas con IA. Hablas, la IA entiende, y la tarea aparece en Voice2Task, Trello o Notion — donde quieras.</div>
  <div class="proj-links">
    <a href="https://github.com/ArocaDev?tab=repositories&q=voice2task" target="_blank" class="proj-link"><i class="ti ti-brand-github"></i>GitHub</a>
  </div>
</div>

<div class="proj-body">

  <div class="proj-section">
    <div class="proj-section-title" data-es="El origen" data-en="The origin">El origen</div>
    <div class="proj-text">
      <p data-es="Todo empezó con <b>bot2trello</b>, un bot de Telegram personal: mandabas un audio y aparecía una tarjeta en Trello. Funcionaba, pero dependía de Telegram como interfaz y no tenía gestión propia de tareas." data-en="It all started with <b>bot2trello</b>, a personal Telegram bot: you sent a voice note and a Trello card appeared. It worked, but it depended on Telegram as the interface and had no task management of its own.">Todo empezó con <b>bot2trello</b>, un bot de Telegram personal: mandabas un audio y aparecía una tarjeta en Trello. Funcionaba, pero dependía de Telegram como interfaz y no tenía gestión propia de tareas.</p>
      <p data-es="La idea era buena. El problema era que podía ser mucho más: una app propia, con interfaz diseñada para esto, integraciones múltiples y gestión de tareas integrada. Así nació Voice2Task." data-en="The idea was solid. The problem was it could be so much more: a dedicated app, with an interface built for this purpose, multiple integrations and built-in task management. That's how Voice2Task was born.">La idea era buena. El problema era que podía ser mucho más: una app propia, con interfaz diseñada para esto, integraciones múltiples y gestión de tareas integrada. Así nació Voice2Task.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="El problema" data-en="The problem">El problema</div>
    <div class="proj-text">
      <p data-es="Capturar una idea o tarea mientras estás ocupado tiene demasiada fricción: parar lo que haces, desbloquear el móvil, abrir la app, escribir. Suficiente para que muchas ideas se pierdan antes de llegar a ningún lado." data-en="Capturing an idea or task when you're busy has too much friction: stop what you're doing, unlock your phone, open the app, type. Enough for many ideas to get lost before going anywhere.">Capturar una idea o tarea mientras estás ocupado tiene demasiada fricción: parar lo que haces, desbloquear el móvil, abrir la app, escribir. Suficiente para que muchas ideas se pierdan antes de llegar a ningún lado.</p>
      <p data-es="Lo ideal es poder <b>decirlo en voz alta</b> y que aparezca solo, estructurado y en el sitio correcto, sin tener que tocarlo más." data-en="The ideal is to be able to <b>say it out loud</b> and have it appear on its own, structured and in the right place, without having to touch it again.">Lo ideal es poder <b>decirlo en voz alta</b> y que aparezca solo, estructurado y en el sitio correcto, sin tener que tocarlo más.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="La solución" data-en="The solution">La solución</div>
    <div class="proj-text">
      <p data-es="Grabas una nota de voz en la app Android. El audio sube al backend, donde <b>Groq Whisper Large V3 Turbo</b> lo transcribe y un segundo modelo extrae título, descripción, fecha límite y prioridad de forma estructurada. La tarea te aparece para revisar antes de guardar — nunca se guarda nada sin confirmación." data-en="You record a voice note in the Android app. The audio goes to the backend, where <b>Groq Whisper Large V3 Turbo</b> transcribes it and a second model extracts title, description, deadline and priority in structured form. The task appears for you to review before saving — nothing is ever saved without confirmation.">Grabas una nota de voz en la app Android. El audio sube al backend, donde <b>Groq Whisper Large V3 Turbo</b> lo transcribe y un segundo modelo extrae título, descripción, fecha límite y prioridad de forma estructurada. La tarea te aparece para revisar antes de guardar — nunca se guarda nada sin confirmación.</p>
      <p data-es="Desde ahí eliges dónde guardarla: en la propia app, en <b>Trello</b>, en <b>Notion</b>, o en los tres a la vez. Las integraciones se configuran desde los ajustes en un flujo de tres pasos." data-en="From there you choose where to save it: in the app itself, in <b>Trello</b>, in <b>Notion</b>, or all three at once. Integrations are configured from settings in a three-step flow.">Desde ahí eliges dónde guardarla: en la propia app, en <b>Trello</b>, en <b>Notion</b>, o en los tres a la vez. Las integraciones se configuran desde los ajustes en un flujo de tres pasos.</p>
      <p data-es="La app tiene gestión completa de tareas y listas, filtros por estado y prioridad, búsqueda por texto, <b>calendario mensual</b> con tareas por fecha, tab de importantes y soporte bilingüe español/inglés." data-en="The app has full task and list management, filters by status and priority, text search, a <b>monthly calendar</b> with tasks by date, an important tasks tab and bilingual Spanish/English support.">La app tiene gestión completa de tareas y listas, filtros por estado y prioridad, búsqueda por texto, <b>calendario mensual</b> con tareas por fecha, tab de importantes y soporte bilingüe español/inglés.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Stack y detalles" data-en="Stack and details">Stack y detalles</div>
    <div class="meta-grid">
      <div class="sidebar-card">
        <div class="sidebar-label">Android</div>
        <div class="sidebar-stack">
          <span class="about-tech-tag">Kotlin 2.0</span><span class="about-tech-tag">Jetpack Compose</span><span class="about-tech-tag">MVVM</span><span class="about-tech-tag">Retrofit</span><span class="about-tech-tag">DataStore</span>
        </div>
      </div>
      <div class="sidebar-card">
        <div class="sidebar-label">Backend</div>
        <div class="sidebar-stack">
          <span class="about-tech-tag">FastAPI</span><span class="about-tech-tag">Python 3.11</span><span class="about-tech-tag">PostgreSQL 16</span><span class="about-tech-tag">SQLAlchemy</span><span class="about-tech-tag">Groq Whisper</span><span class="about-tech-tag">Docker</span>
        </div>
      </div>
      <div class="sidebar-card">
        <div class="sidebar-label" data-es="Detalles" data-en="Details">Detalles</div>
        <div class="sidebar-detail">
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Tipo" data-en="Type">Tipo</span><span class="sidebar-row-val" data-es="Personal" data-en="Personal">Personal</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Año" data-en="Year">Año</span><span class="sidebar-row-val">2025 – 2026</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label">Tests backend</span><span class="sidebar-row-val">93</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Estado" data-en="Status">Estado</span><span class="sidebar-row-val" data-es="En desarrollo" data-en="In development">En desarrollo</span></div>
        </div>
      </div>
      <div class="sidebar-card">
        <div class="sidebar-label" data-es="Integraciones" data-en="Integrations">Integraciones</div>
        <div class="sidebar-stack">
          <span class="about-tech-tag">Trello API</span><span class="about-tech-tag">Notion API</span><span class="about-tech-tag">Groq Whisper</span>
        </div>
      </div>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Lo que aprendí" data-en="What I learned">Lo que aprendí</div>
    <div class="proj-text">
      <p data-es="Primer proyecto donde coordiné tres repositorios independientes con contratos de API entre ellos. Aprendí a diseñar endpoints pensando en el cliente Android, no solo en lo que era fácil de implementar en el backend." data-en="First project where I coordinated three independent repositories with API contracts between them. I learned to design endpoints thinking about the Android client, not just what was easy to implement on the backend.">Primer proyecto donde coordiné tres repositorios independientes con contratos de API entre ellos. Aprendí a diseñar endpoints pensando en el cliente Android, no solo en lo que era fácil de implementar en el backend.</p>
      <p data-es="También fue el primer proyecto serio con Kotlin y Jetpack Compose. El modelo mental de Compose — UI como función del estado — es diferente al desarrollo web y requiere pensar de otra forma cómo fluye la información." data-en="It was also my first serious project with Kotlin and Jetpack Compose. The mental model of Compose — UI as a function of state — is different from web development and requires thinking differently about how information flows.">También fue el primer proyecto serio con Kotlin y Jetpack Compose. El modelo mental de Compose — UI como función del estado — es diferente al desarrollo web y requiere pensar de otra forma cómo fluye la información.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="¿Qué haría diferente hoy?" data-en="What I'd do differently today">¿Qué haría diferente hoy?</div>
    <div class="proj-text">
      <ul class="proj-list">
        <li data-es="Añadiría procesamiento asíncrono con Celery + Redis para el audio, en lugar de procesarlo síncronamente en el endpoint." data-en="I'd add async processing with Celery + Redis for audio, instead of processing it synchronously in the endpoint.">Añadiría procesamiento asíncrono con Celery + Redis para el audio, en lugar de procesarlo síncronamente en el endpoint.</li>
        <li data-es="En Android usaría Hilt para inyección de dependencias desde el principio en lugar de la gestión manual actual." data-en="On Android I'd use Hilt for dependency injection from the start instead of the current manual management.">En Android usaría Hilt para inyección de dependencias desde el principio en lugar de la gestión manual actual.</li>
        <li data-es="Definiría el contrato de API con OpenAPI antes de empezar a desarrollar los dos lados, no en paralelo." data-en="I'd define the API contract with OpenAPI before starting to develop both sides, not in parallel.">Definiría el contrato de API con OpenAPI antes de empezar a desarrollar los dos lados, no en paralelo.</li>
      </ul>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Diagramas" data-en="Diagrams">Diagramas</div>
    <div class="diagram-grid">
      <div class="diagram-wrap" onclick="window.open('/proyectos/voice2task/voice2task_arquitectura.svg','_blank')">
        <div class="diagram-item" style="width:100%;cursor:pointer">
          <object data="/proyectos/voice2task/voice2task_arquitectura.svg" type="image/svg+xml"></object>
        </div>
        <span class="diagram-label" data-es="Arquitectura del sistema · clic para ampliar" data-en="System architecture · click to enlarge">Arquitectura del sistema · clic para ampliar</span>
      </div>
      <div class="diagram-wrap" onclick="window.open('/proyectos/voice2task/voice2task_flujo_audio.svg','_blank')">
        <div class="diagram-item" style="width:100%;cursor:pointer">
          <object data="/proyectos/voice2task/voice2task_flujo_audio.svg" type="image/svg+xml"></object>
        </div>
        <span class="diagram-label" data-es="Flujo de audio a tarea · clic para ampliar" data-en="Audio to task flow · click to enlarge">Flujo de audio a tarea · clic para ampliar</span>
      </div>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Grabación y tarea" data-en="Recording and task">Grabación y tarea</div>
    <div class="gif-label" data-es="Pulsa para reproducir. Pulsa de nuevo para pausar." data-en="Click to play. Click again to pause.">Pulsa para reproducir. Pulsa de nuevo para pausar.</div>
    <div class="gif-container mobile-gif" id="gif-audio">
      <img id="gif-audio-img" src="/proyectos/voice2task/audio.jpeg" data-gif="/proyectos/voice2task/demo-audio.gif" data-still="/proyectos/voice2task/audio.jpeg" alt="Demo grabación" />
      <div class="gif-overlay" id="gif-audio-overlay">
        <div class="gif-play-btn"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="5,3 19,12 5,21"/></svg></div>
      </div>
    </div>
    <p class="proj-text" style="margin-top:14px;font-size:13px" data-es="Pulsa el micrófono, habla y suelta. El audio viaja al backend, Whisper lo transcribe y la IA extrae título, descripción, fecha límite y prioridad. La tarea aparece lista para revisar antes de guardar." data-en="Tap the mic, speak and release. The audio goes to the backend, Whisper transcribes it and the AI extracts title, description, deadline and priority. The task appears ready to review before saving.">Pulsa el micrófono, habla y suelta. El audio viaja al backend, Whisper lo transcribe y la IA extrae título, descripción, fecha límite y prioridad. La tarea aparece lista para revisar antes de guardar.</p>
  </div>

  <div class="proj-section" style="margin-top:48px">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Ajustes e integraciones" data-en="Settings and integrations">Ajustes e integraciones</div>
    <div class="gif-label" data-es="Pulsa para reproducir. Pulsa de nuevo para pausar." data-en="Click to play. Click again to pause.">Pulsa para reproducir. Pulsa de nuevo para pausar.</div>
    <div class="gif-container mobile-gif" id="gif-settings">
      <img id="gif-settings-img" src="/proyectos/voice2task/integraciones.png" data-gif="/proyectos/voice2task/demo-settings.gif" data-still="/proyectos/voice2task/integraciones.png" alt="Demo ajustes" />
      <div class="gif-overlay" id="gif-settings-overlay">
        <div class="gif-play-btn"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="5,3 19,12 5,21"/></svg></div>
      </div>
    </div>
    <p class="proj-text" style="margin-top:14px;font-size:13px" data-es="Conecta Trello y Notion en tres pasos desde los ajustes. Una vez configuradas, cada nueva tarea puede enviarse a uno o ambos servicios a la vez, además de guardarse en la app." data-en="Connect Trello and Notion in three steps from settings. Once configured, each new task can be sent to one or both services at once, in addition to being saved in the app.">Conecta Trello y Notion en tres pasos desde los ajustes. Una vez configuradas, cada nueva tarea puede enviarse a uno o ambos servicios a la vez, además de guardarse en la app.</p>
  </div>

  <div class="proj-section" style="margin-top:48px">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Calendario" data-en="Calendar">Calendario</div>
    <div class="gif-label" data-es="Pulsa para reproducir. Pulsa de nuevo para pausar." data-en="Click to play. Click again to pause.">Pulsa para reproducir. Pulsa de nuevo para pausar.</div>
    <div class="gif-container mobile-gif" id="gif-cal">
      <img id="gif-cal-img" src="/proyectos/voice2task/calendario.png" data-gif="/proyectos/voice2task/demo-calendario.gif" data-still="/proyectos/voice2task/calendario.png" alt="Demo calendario" />
      <div class="gif-overlay" id="gif-cal-overlay">
        <div class="gif-play-btn"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polygon points="5,3 19,12 5,21"/></svg></div>
      </div>
    </div>
    <p class="proj-text" style="margin-top:14px;font-size:13px" data-es="Vista mensual con marcadores en los días que tienen tareas. Pulsa un día para ver las tareas de esa fecha filtradas directamente desde el calendario." data-en="Monthly view with markers on days that have tasks. Tap a day to see that date's tasks filtered directly from the calendar.">Vista mensual con marcadores en los días que tienen tareas. Pulsa un día para ver las tareas de esa fecha filtradas directamente desde el calendario.</p>
  </div>

  <div class="proj-section" style="margin-top:48px">
    <div class="proj-section-title" data-es="Capturas de la app" data-en="Screenshots — Android app">Capturas de la app</div>
    <div class="carousel-hint" data-es="Usa las flechas para navegar. Haz clic en la imagen para verla completa." data-en="Use the arrows to browse. Click the image to view full size.">Usa las flechas para navegar. Haz clic en la imagen para verla completa.</div>
    <div class="carousel mobile-carousel">
      <button class="carousel-btn" id="app-prev"><i class="ti ti-chevron-left"></i></button>
      <div class="carousel-track mobile-track" id="app-track">
        <div class="carousel-slide mobile active">
          <img src="/proyectos/voice2task/login.png" alt="Login" onclick="window.open(this.src,'_blank')" />
          <span data-es="Login" data-en="Login">Login</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/voice2task/registro.png" alt="Registro" onclick="window.open(this.src,'_blank')" />
          <span data-es="Registro" data-en="Register">Registro</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/voice2task/listas.png" alt="Mis listas" onclick="window.open(this.src,'_blank')" />
          <span data-es="Mis listas" data-en="My lists">Mis listas</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/voice2task/subtareas.png" alt="Tareas" onclick="window.open(this.src,'_blank')" />
          <span data-es="Lista de tareas con filtros" data-en="Task list with filters">Lista de tareas con filtros</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/voice2task/audio.jpeg" alt="Grabando audio" onclick="window.open(this.src,'_blank')" />
          <span data-es="Grabando audio" data-en="Recording audio">Grabando audio</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/voice2task/calendario.png" alt="Calendario" onclick="window.open(this.src,'_blank')" />
          <span data-es="Calendario con tareas" data-en="Calendar with tasks">Calendario con tareas</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/voice2task/integraciones.png" alt="Integraciones" onclick="window.open(this.src,'_blank')" />
          <span data-es="Ajustes e integraciones" data-en="Settings and integrations">Ajustes e integraciones</span>
