---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="es" id="html-root">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GestPro · ArocaDev</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  <style>
    .section-divider{border-top:1px solid rgba(0,0,0,0.07);margin:64px 0}
    .proj-section{margin-bottom:72px}
    .proj-section-title{margin-bottom:24px}
    .carousel{position:relative;display:flex;align-items:center;gap:10px}
    .carousel-track{flex:1;overflow:hidden;border-radius:8px;border:1px solid rgba(0,0,0,0.07);background:#f8f9fa}
    .carousel-slide{display:none;flex-direction:column}
    .carousel-slide.active{display:flex}
    .carousel-slide img{width:100%;display:block;cursor:pointer;max-height:760px;object-fit:cover;object-position:top}
    .carousel-slide span{font-size:11px;color:#888;padding:10px 14px;text-align:center;display:block}
    .carousel-btn{width:36px;height:36px;border-radius:50%;background:rgba(129,140,248,0.15);border:1px solid rgba(129,140,248,0.4);color:var(--ac);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background 0.2s}
    .carousel-btn:hover{background:rgba(129,140,248,0.3)}
    .carousel-dots{display:flex;justify-content:center;gap:6px;margin-top:12px}
    .dot{width:6px;height:6px;border-radius:50%;background:rgba(0,0,0,0.15);cursor:pointer;transition:background 0.2s}
    .dot.active{background:var(--ac)}
    .carousel-hint{font-size:11px;color:var(--t4);margin-bottom:16px;text-align:center}
    .mobile-carousel{justify-content:center}
    .carousel-track.mobile-track{flex:unset;width:320px;background:#f8f9fa;border:1px solid rgba(0,0,0,0.07);border-radius:8px;overflow:hidden}
    .carousel-slide.mobile img{width:100%;max-height:520px;object-fit:contain;object-position:top;display:block;cursor:pointer}
    .diagram-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .diagram-item{border-radius:8px;overflow:hidden;cursor:pointer;border:1px solid rgba(0,0,0,0.07);background:#fff;padding:8px}
    .diagram-item object{width:100%;height:300px;display:block;pointer-events:none;border-radius:4px}
    .diagram-wrap{display:flex;flex-direction:column;align-items:center;gap:8px}
    .diagram-label{font-size:11px;color:var(--t4);text-align:center}
    .video-container{border-radius:8px;overflow:hidden;border:1px solid rgba(0,0,0,0.07);background:#f8f9fa}
    .video-container video{width:100%;display:block}
    .video-container.mobile-video{width:320px;margin:0 auto}
    .video-container.mobile-video video{max-height:520px;object-fit:contain}
  </style>
</head>
<body>

<nav><div class="nav-inner">
  <a href="/" class="logo">aroca<span>.dev</span></a>
  <div class="nav-r">
    <div class="nav-links">
      <a href="/#sobre-mi" data-es="sobre mí" data-en="about">sobre mí</a>
      <a href="/#proyectos" data-es="proyectos" data-en="projects">proyectos</a>
      <a href="/#experiencia" data-es="experiencia" data-en="experience">experiencia</a>
      <a href="/#contacto" data-es="contacto" data-en="contact">contacto</a>
      <a href="/#que-viene-ahora" data-es="próximo objetivo" data-en="next goal">próximo objetivo</a>
    </div>
    <div class="i18n"><span class="i18n-btn" id="btn-es">ES</span><span class="i18n-sep">|</span><span class="i18n-btn" id="btn-en">EN</span></div>
  </div>
</div></nav>

<div class="proj-hero">
  <div class="proj-category" data-es="Proyecto personal · Android" data-en="Personal project · Android">Proyecto personal · Android</div>
  <div class="proj-title">GestPro</div>
  <div class="proj-subtitle" data-es="App Android para autónomos y pequeñas empresas. Gestiona proyectos, tareas, materiales, pagos, cobros y finanzas — todo desde el móvil, sin conexión." data-en="Android app for freelancers and small businesses. Manage projects, tasks, materials, payments, invoices and finances — all from your phone, offline.">App Android para autónomos y pequeñas empresas. Gestiona proyectos, tareas, materiales, pagos, cobros y finanzas — todo desde el móvil, sin conexión.</div>
  <div class="proj-links">
    <a href="https://github.com/Arocadev/gest_pro" target="_blank" class="proj-link"><i class="ti ti-brand-github"></i>GitHub</a>
    <a href="https://github.com/Arocadev/gest_pro/releases/tag/v1.0.0" target="_blank" class="proj-link proj-link-web"><i class="ti ti-device-mobile-down"></i><span data-es="Descargar APK" data-en="Download APK">Descargar APK</span></a>
  </div>
</div>

<div class="proj-body">

  <div class="proj-section">
    <div class="proj-section-title" data-es="El origen" data-en="The origin">El origen</div>
    <div class="proj-text">
      <p data-es="Todo empezó con <b>ObrasControl</b>, una app personal para gestionar obras de construcción. Al desarrollar una versión para un cliente real del sector (<b>Vulldecor Gestiones</b>), quedó claro que la lógica era lo suficientemente genérica como para servir a cualquier tipo de negocio." data-en="It all started with <b>ObrasControl</b>, a personal app for managing construction projects. When developing a version for a real client in the sector (<b>Vulldecor Gestiones</b>), it became clear that the logic was generic enough to serve any type of business.">Todo empezó con <b>ObrasControl</b>, una app personal para gestionar obras de construcción. Al desarrollar una versión para un cliente real del sector (<b>Vulldecor Gestiones</b>), quedó claro que la lógica era lo suficientemente genérica como para servir a cualquier tipo de negocio.</p>
      <p data-es="GestPro es esa evolución: la versión generalizada y definitiva, pensada para autónomos y pequeñas empresas de cualquier sector que necesiten gestionar proyectos y finanzas desde el móvil sin depender de conexión a internet." data-en="GestPro is that evolution: the generalised, definitive version, designed for freelancers and small businesses in any sector who need to manage projects and finances from their phone without depending on an internet connection.">GestPro es esa evolución: la versión generalizada y definitiva, pensada para autónomos y pequeñas empresas de cualquier sector que necesiten gestionar proyectos y finanzas desde el móvil sin depender de conexión a internet.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="La solución" data-en="The solution">La solución</div>
    <div class="proj-text">
      <p data-es="Aplicación Android nativa con <b>Flutter y Dart</b>, almacenamiento local con <b>Hive</b> y funcionamiento completamente offline. El flujo central es simple: creas un proyecto, le añades tareas con fechas límite, registras materiales con IVA y llevas el control económico desde un panel que muestra presupuesto, cobrado, pendiente y beneficio estimado en tiempo real." data-en="Native Android application with <b>Flutter and Dart</b>, local storage with <b>Hive</b> and fully offline operation. The core flow is simple: create a project, add tasks with deadlines, log materials with VAT and track finances from a panel showing budget, invoiced, pending and estimated profit in real time.">Aplicación Android nativa con <b>Flutter y Dart</b>, almacenamiento local con <b>Hive</b> y funcionamiento completamente offline. El flujo central es simple: creas un proyecto, le añades tareas con fechas límite, registras materiales con IVA y llevas el control económico desde un panel que muestra presupuesto, cobrado, pendiente y beneficio estimado en tiempo real.</p>
      <p data-es="El <b>dashboard de estadísticas</b> tiene cinco gráficas interactivas — distribución financiera, comparativa económica, estado de proyectos, top proyectos por presupuesto y progreso de tareas — cada una con un botón de información que explica qué muestra." data-en="The <b>statistics dashboard</b> has five interactive charts — financial distribution, economic comparison, project status, top projects by budget and task progress — each with an info button explaining what it shows.">El <b>dashboard de estadísticas</b> tiene cinco gráficas interactivas — distribución financiera, comparativa económica, estado de proyectos, top proyectos por presupuesto y progreso de tareas — cada una con un botón de información que explica qué muestra.</p>
      <p data-es="Incluye generación de <b>PDF profesional</b> por proyecto con cabecera, resumen económico y tablas de tareas y materiales, y un sistema de <b>backup en JSON</b> para exportar e importar todos los datos entre dispositivos." data-en="Includes <b>professional PDF generation</b> per project with header, financial summary and task and material tables, and a <b>JSON backup system</b> to export and import all data between devices.">Incluye generación de <b>PDF profesional</b> por proyecto con cabecera, resumen económico y tablas de tareas y materiales, y un sistema de <b>backup en JSON</b> para exportar e importar todos los datos entre dispositivos.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Stack y detalles" data-en="Stack and details">Stack y detalles</div>
    <div class="meta-grid">
      <div class="sidebar-card">
        <div class="sidebar-label" data-es="Stack técnico" data-en="Tech stack">Stack técnico</div>
        <div class="sidebar-stack">
          <span class="about-tech-tag">Flutter 3</span><span class="about-tech-tag">Dart</span><span class="about-tech-tag">Hive</span><span class="about-tech-tag">fl_chart</span><span class="about-tech-tag">table_calendar</span><span class="about-tech-tag">pdf + printing</span>
        </div>
      </div>
      <div class="sidebar-card">
        <div class="sidebar-label" data-es="Detalles" data-en="Details">Detalles</div>
        <div class="sidebar-detail">
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Tipo" data-en="Type">Tipo</span><span class="sidebar-row-val" data-es="Personal" data-en="Personal">Personal</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Plataforma" data-en="Platform">Plataforma</span><span class="sidebar-row-val">Android 6.0+</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Año" data-en="Year">Año</span><span class="sidebar-row-val">2026</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Estado" data-en="Status">Estado</span><span class="sidebar-row-val" data-es="Funcional" data-en="Functional">Funcional</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Lo que aprendí" data-en="What I learned">Lo que aprendí</div>
    <div class="proj-text">
      <p data-es="GestPro fue mi primer proyecto serio con Flutter. Aprendí a gestionar estado local con Hive, a trabajar con gráficas interactivas y a generar PDFs desde código en un entorno móvil." data-en="GestPro was my first serious project with Flutter. I learned to manage local state with Hive, work with interactive charts and generate PDFs from code in a mobile environment.">GestPro fue mi primer proyecto serio con Flutter. Aprendí a gestionar estado local con Hive, a trabajar con gráficas interactivas y a generar PDFs desde código en un entorno móvil.</p>
      <p data-es="El proceso de generalizar la app desde un caso concreto a uno genérico me obligó a pensar en abstracciones y en cómo diseñar modelos de datos flexibles sin romper lo que ya funcionaba." data-en="The process of generalising the app from a specific case to a generic one forced me to think about abstractions and how to design flexible data models without breaking what already worked.">El proceso de generalizar la app desde un caso concreto a uno genérico me obligó a pensar en abstracciones y en cómo diseñar modelos de datos flexibles sin romper lo que ya funcionaba.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="¿Qué haría diferente hoy?" data-en="What I'd do differently today">¿Qué haría diferente hoy?</div>
    <div class="proj-text">
      <ul class="proj-list">
        <li data-es="Añadiría sincronización con backend para no depender exclusivamente del backup manual entre dispositivos." data-en="I'd add backend sync to avoid relying solely on manual backup between devices.">Añadiría sincronización con backend para no depender exclusivamente del backup manual entre dispositivos.</li>
        <li data-es="Separaría la lógica de negocio de la UI desde el principio con un patrón más claro (BLoC o Riverpod)." data-en="I'd separate business logic from UI from the start with a clearer pattern (BLoC or Riverpod).">Separaría la lógica de negocio de la UI desde el principio con un patrón más claro (BLoC o Riverpod).</li>
        <li data-es="Añadiría tests unitarios para los servicios de cálculo financiero y generación de PDF." data-en="I'd add unit tests for the financial calculation and PDF generation services.">Añadiría tests unitarios para los servicios de cálculo financiero y generación de PDF.</li>
      </ul>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Diagramas" data-en="Diagrams">Diagramas</div>
    <div class="diagram-grid">
      <div class="diagram-wrap" onclick="window.open('/proyectos/gestpro/gestpro_arquitectura.svg','_blank')">
        <div class="diagram-item" style="width:100%;cursor:pointer">
          <object data="/proyectos/gestpro/gestpro_arquitectura.svg" type="image/svg+xml"></object>
        </div>
        <span class="diagram-label" data-es="Arquitectura · clic para ampliar" data-en="Architecture · click to enlarge">Arquitectura · clic para ampliar</span>
      </div>
      <div class="diagram-wrap" onclick="window.open('/proyectos/gestpro/gestpro_flujo_proyecto.svg','_blank')">
        <div class="diagram-item" style="width:100%;cursor:pointer">
          <object data="/proyectos/gestpro/gestpro_flujo_proyecto.svg" type="image/svg+xml"></object>
        </div>
        <span class="diagram-label" data-es="Flujo de proyecto · clic para ampliar" data-en="Project flow · click to enlarge">Flujo de proyecto · clic para ampliar</span>
      </div>
    </div>
  </div>

  <div class="proj-section" style="margin-top:48px">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Crear proyecto" data-en="Create project">Crear proyecto</div>
    <div class="video-container mobile-video">
      <video playsinline muted controls>
        <source src="/proyectos/gestpro/crear-proyecto.mp4" type="video/mp4" />
      </video>
    </div>
    <p class="proj-text" style="margin-top:14px;font-size:13px" data-es="Crea un proyecto, añade tareas con fecha límite y registra materiales con IVA. El panel económico se actualiza en tiempo real con presupuesto, cobrado, pendiente y beneficio estimado." data-en="Create a project, add tasks with deadlines and log materials with VAT. The financial panel updates in real time with budget, invoiced, pending and estimated profit.">Crea un proyecto, añade tareas con fecha límite y registra materiales con IVA. El panel económico se actualiza en tiempo real con presupuesto, cobrado, pendiente y beneficio estimado.</p>
  </div>

  <div class="proj-section" style="margin-top:48px">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Finanzas" data-en="Finances">Finanzas</div>
    <div class="video-container mobile-video">
      <video playsinline muted controls>
        <source src="/proyectos/gestpro/crear-finanza.mp4" type="video/mp4" />
      </video>
    </div>
    <p class="proj-text" style="margin-top:14px;font-size:13px" data-es="Registra pagos y cobros por proyecto con importes, fechas y notas. El resumen financiero calcula automáticamente el balance y el beneficio estimado." data-en="Log payments and invoices per project with amounts, dates and notes. The financial summary automatically calculates the balance and estimated profit.">Registra pagos y cobros por proyecto con importes, fechas y notas. El resumen financiero calcula automáticamente el balance y el beneficio estimado.</p>
  </div>

  <div class="proj-section" style="margin-top:48px">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Calendario" data-en="Calendar">Calendario</div>
    <div class="video-container mobile-video">
      <video playsinline muted controls>
        <source src="/proyectos/gestpro/calendario.mp4" type="video/mp4" />
      </video>
    </div>
    <p class="proj-text" style="margin-top:14px;font-size:13px" data-es="Vista mensual con marcadores en los días que tienen tareas asignadas. Pulsa un día para ver las tareas pendientes de esa fecha." data-en="Monthly view with markers on days that have assigned tasks. Tap a day to see the tasks due on that date.">Vista mensual con marcadores en los días que tienen tareas asignadas. Pulsa un día para ver las tareas pendientes de esa fecha.</p>
  </div>

  <div class="proj-section" style="margin-top:48px">
    <div class="proj-section-title" style="margin-bottom:20px" data-es="Estadísticas" data-en="Statistics">Estadísticas</div>
    <div class="video-container mobile-video">
      <video playsinline muted controls>
        <source src="/proyectos/gestpro/resumen.mp4" type="video/mp4" />
      </video>
    </div>
    <p class="proj-text" style="margin-top:14px;font-size:13px" data-es="Dashboard con cinco gráficas interactivas: distribución financiera, comparativa económica, estado de proyectos, top proyectos por presupuesto y progreso de tareas. Cada gráfica tiene un botón ⓘ que explica qué muestra." data-en="Dashboard with five interactive charts: financial distribution, economic comparison, project status, top projects by budget and task progress. Each chart has an ⓘ button explaining what it shows.">Dashboard con cinco gráficas interactivas: distribución financiera, comparativa económica, estado de proyectos, top proyectos por presupuesto y progreso de tareas. Cada gráfica tiene un botón ⓘ que explica qué muestra.</p>
  </div>

  <div class="proj-section" style="margin-top:48px">
    <div class="proj-section-title" data-es="Capturas" data-en="Screenshots">Capturas</div>
    <div class="carousel-hint" data-es="Usa las flechas para navegar. Haz clic en la imagen para verla completa." data-en="Use the arrows to browse. Click the image to view full size.">Usa las flechas para navegar. Haz clic en la imagen para verla completa.</div>
    <div class="carousel mobile-carousel">
      <button class="carousel-btn" id="gp-prev"><i class="ti ti-chevron-left"></i></button>
      <div class="carousel-track mobile-track" id="gp-track">
        <div class="carousel-slide mobile active">
          <img src="/proyectos/gestpro/lista-proyecto.png" alt="Lista de proyectos" onclick="window.open(this.src,'_blank')" />
          <span data-es="Lista de proyectos" data-en="Projects list">Lista de proyectos</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/gestpro/detalles-proyecto.png" alt="Detalle de proyecto" onclick="window.open(this.src,'_blank')" />
          <span data-es="Detalle de proyecto" data-en="Project detail">Detalle de proyecto</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/gestpro/lista-pago.png" alt="Pagos" onclick="window.open(this.src,'_blank')" />
          <span data-es="Pagos" data-en="Payments">Pagos</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/gestpro/lista-cobro.png" alt="Cobros" onclick="window.open(this.src,'_blank')" />
          <span data-es="Cobros" data-en="Invoices">Cobros</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/gestpro/resumen.png" alt="Resumen" onclick="window.open(this.src,'_blank')" />
          <span data-es="Panel de resumen" data-en="Summary panel">Panel de resumen</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/gestpro/grafica.png" alt="Gráficas" onclick="window.open(this.src,'_blank')" />
          <span data-es="Distribución financiera" data-en="Financial distribution">Distribución financiera</span>
        </div>
        <div class="carousel-slide mobile">
          <img src="/proyectos/gestpro/calendario.png" alt="Calendario" onclick="window.open(this.src,'_blank')" />
          <span data-es="Calendario mensual" data-en="Monthly calendar">Calendario mensual</span>
        </div>
      </div>
      <button class="carousel-btn" id="gp-next"><i class="ti ti-chevron-right"></i></button>
    </div>
    <div class="carousel-dots" id="gp-dots">
      <span class="dot active" onclick="goToGpSlide(0)"></span>
      <span class="dot" onclick="goToGpSlide(1)"></span>
      <span class="dot" onclick="goToGpSlide(2)"></span>
      <span class="dot" onclick="goToGpSlide(3)"></span>
      <span class="dot" onclick="goToGpSlide(4)"></span>
      <span class="dot" onclick="goToGpSlide(5)"></span>
      <span class="dot" onclick="goToGpSlide(6)"></span>
    </div>
  </div>

</div>

<footer>
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
    <span class="fc">© 2026 Alejandro Rodríguez Calabuig</span>
    <span class="fc" style="font-size:11px;color:var(--t4)" data-es="Construido con Astro · Deploy en Vercel" data-en="Built with Astro · Deployed on Vercel">Construido con Astro · Deploy en Vercel</span>
  </div>
</footer>

<script>
  let gpSlide = 0;
  const gpSlides = document.querySelectorAll('#gp-track .carousel-slide');
  const gpDots = document.querySelectorAll('#gp-dots .dot');
  function goToGpSlide(n) {
    gpSlides[gpSlide].classList.remove('active'); gpDots[gpSlide].classList.remove('active');
    gpSlide = (n + gpSlides.length) % gpSlides.length;
    gpSlides[gpSlide].classList.add('active'); gpDots[gpSlide].classList.add('active');
  }
  document.getElementById('gp-prev').addEventListener('click', () => goToGpSlide(gpSlide - 1));
  document.getElementById('gp-next').addEventListener('click', () => goToGpSlide(gpSlide + 1));

  const ES='es',EN='en';
  let current=localStorage.getItem('lang')||ES;
  const btnEs=document.getElementById('btn-es'),btnEn=document.getElementById('btn-en');
  function applyLang(lang){current=lang;localStorage.setItem('lang',lang);btnEs.className=lang===ES?'i18n-active':'i18n-inactive';btnEn.className=lang===EN?'i18n-active':'i18n-inactive';document.getElementById('html-root').lang=lang===ES?'es':'en';document.querySelectorAll('[data-es]').forEach(el=>{const t=el.getAttribute(`data-${lang}`);if(t)el.innerHTML=t;});}
  btnEs.addEventListener('click',()=>applyLang(ES));btnEn.addEventListener('click',()=>applyLang(EN));
  applyLang(current);
</script>
</body>
</html>