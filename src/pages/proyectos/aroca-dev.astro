</nav>

<div class="nav-mobile" id="nav-mobile" role="navigation">
  <a href="/#sobre-mi" data-es="Sobre mí" data-en="About">Sobre mí</a>
  <a href="/#proyectos" data-es="Proyectos" data-en="Projects">Proyectos</a>
  <a href="/#experiencia" data-es="Experiencia" data-en="Experience">Experiencia</a>
  <a href="/#contacto" data-es="Contacto" data-en="Contact">Contacto</a>
  <a href="/#que-viene-ahora" data-es="Próximo objetivo" data-en="Next goal">Próximo objetivo</a>
</div>

<div class="proj-hero">
  <div class="proj-category" data-es="Proyecto personal · En producción" data-en="Personal project · Live">Proyecto personal · En producción</div>
  <div class="proj-title">aroca.dev</div>
  <div class="proj-subtitle" data-es="El portfolio que estás viendo. Diseñado e implementado desde cero con Astro y CSS puro." data-en="The portfolio you're looking at. Designed and built from scratch with Astro and plain CSS.">El portfolio que estás viendo. Diseñado e implementado desde cero con Astro y CSS puro.</div>
  <div class="proj-links">
    <a href="https://github.com/ArocaDev/aroca-dev" target="_blank" class="proj-link"><i class="ti ti-brand-github"></i>GitHub</a>
  </div>
</div>

<div class="proj-body">

  <div class="proj-section">
    <div class="proj-section-title" data-es="Por qué construirlo desde cero" data-en="Why build it from scratch">Por qué construirlo desde cero</div>
    <div class="proj-text">
      <p data-es="Un CV en PDF no puede mostrar el contexto de un proyecto: qué problema resolvía, qué decisiones se tomaron, qué salió bien y qué haría diferente. Para eso hace falta una página propia." data-en="A PDF CV can't show a project's context: what problem it solved, what decisions were made, what went well and what I'd do differently. For that you need a dedicated page.">Un CV en PDF no puede mostrar el contexto de un proyecto: qué problema resolvía, qué decisiones se tomaron, qué salió bien y qué haría diferente. Para eso hace falta una página propia.</p>
      <p data-es="Y si vas a hacer un portfolio, tiene más sentido construirlo tú mismo que usar una plantilla. El proceso en sí ya dice algo sobre cómo trabajas." data-en="And if you're going to have a portfolio, it makes more sense to build it yourself than use a template. The process itself already says something about how you work.">Y si vas a hacer un portfolio, tiene más sentido construirlo tú mismo que usar una plantilla. El proceso en sí ya dice algo sobre cómo trabajas.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Decisiones técnicas" data-en="Technical decisions">Decisiones técnicas</div>
    <div class="proj-text">
      <p data-es="<b>Astro</b> por su rendimiento y su modelo de cero JavaScript por defecto — un portfolio no necesita hidratación del cliente." data-en="<b>Astro</b> for its performance and zero-JavaScript-by-default model — a portfolio doesn't need client-side hydration."><b>Astro</b> por su rendimiento y su modelo de cero JavaScript por defecto — un portfolio no necesita hidratación del cliente.</p>
      <p data-es="<b>CSS puro</b> con variables para el sistema de color. Sin frameworks, sin clases de utilidad, sin dependencias innecesarias. Control total sobre cada decisión visual." data-en="<b>Plain CSS</b> with variables for the colour system. No frameworks, no utility classes, no unnecessary dependencies. Full control over every visual decision."><b>CSS puro</b> con variables para el sistema de color. Sin frameworks, sin clases de utilidad, sin dependencias innecesarias. Control total sobre cada decisión visual.</p>
      <p data-es="Sistema de color propio: fondo marino <b>#0d1117</b>, acento índigo <b>#818cf8</b> y jerarquía de cuatro niveles de texto. Tipografía Space Grotesk para títulos e Inter para texto corrido." data-en="Custom colour system: navy background <b>#0d1117</b>, indigo accent <b>#818cf8</b> and a four-level text hierarchy. Space Grotesk for headings and Inter for body text.">Sistema de color propio: fondo marino <b>#0d1117</b>, acento índigo <b>#818cf8</b> y jerarquía de cuatro niveles de texto. Tipografía Space Grotesk para títulos e Inter para texto corrido.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Stack y detalles" data-en="Stack and details">Stack y detalles</div>
    <div class="meta-grid">
      <div class="sidebar-card">
        <div class="sidebar-label" data-es="Stack técnico" data-en="Tech stack">Stack técnico</div>
        <div class="sidebar-stack"><span class="about-tech-tag">Astro</span><span class="about-tech-tag">CSS</span><span class="about-tech-tag">Tabler Icons</span><span class="about-tech-tag">Vercel</span></div>
      </div>
      <div class="sidebar-card">
        <div class="sidebar-label" data-es="Detalles" data-en="Details">Detalles</div>
        <div class="sidebar-detail">
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Tipo" data-en="Type">Tipo</span><span class="sidebar-row-val" data-es="Personal" data-en="Personal">Personal</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Año" data-en="Year">Año</span><span class="sidebar-row-val">2026</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Estado" data-en="Status">Estado</span><span class="sidebar-row-val" data-es="En producción" data-en="Live">En producción</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label">Web</span><span class="sidebar-row-val">aroca.dev</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Lo que aprendí" data-en="What I learned">Lo que aprendí</div>
    <div class="proj-text">
      <p data-es="Construir el portfolio desde cero me obligó a tomar decisiones de diseño real: sistema de color, jerarquía tipográfica, espaciados, estructura de navegación. No hay plantilla que te salve de pensar." data-en="Building the portfolio from scratch forced me to make real design decisions: colour system, typographic hierarchy, spacing, navigation structure. No template saves you from thinking.">Construir el portfolio desde cero me obligó a tomar decisiones de diseño real: sistema de color, jerarquía tipográfica, espaciados, estructura de navegación. No hay plantilla que te salve de pensar.</p>
      <p data-es="También aprendí a gestionar un proyecto propio con criterio de producto: qué incluir, qué quitar, cómo contar cada proyecto para que tenga sentido para alguien que no lo ha vivido." data-en="I also learned to manage a personal project with a product mindset: what to include, what to cut, how to tell each project's story in a way that makes sense to someone who wasn't there.">También aprendí a gestionar un proyecto propio con criterio de producto: qué incluir, qué quitar, cómo contar cada proyecto para que tenga sentido para alguien que no lo ha vivido.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="¿Qué haría diferente hoy?" data-en="What I'd do differently today">¿Qué haría diferente hoy?</div>
    <div class="proj-text">
      <ul class="proj-list">
        <li data-es="Usaría componentes Astro para el nav y el footer en vez de repetirlos en cada página." data-en="I'd use Astro components for the nav and footer instead of repeating them on every page.">Usaría componentes Astro para el nav y el footer en vez de repetirlos en cada página.</li>
        <li data-es="Añadiría animaciones de entrada sutiles desde el principio — ahora añadirlas requiere tocar muchos archivos." data-en="I'd add subtle entry animations from the start — adding them now means touching a lot of files.">Añadiría animaciones de entrada sutiles desde el principio — ahora añadirlas requiere tocar muchos archivos.</li>
        <li data-es="Definiría el sistema de color y tipografía antes de maquetar, no mientras." data-en="I'd define the colour and typography system before laying out, not during.">Definiría el sistema de color y tipografía antes de maquetar, no mientras.</li>
      </ul>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Diagrama de arquitectura" data-en="Architecture diagram">Diagrama de arquitectura</div>
    <div class="diagram-item" onclick="window.open('/proyectos/aroca-dev/arquitectura.svg','_blank')">
      <object data="/proyectos/aroca-dev/arquitectura.svg" type="image/svg+xml"></object>
    </div>
    <div class="diagram-label" data-es="Arquitectura · clic para ampliar" data-en="Architecture · click to enlarge">Arquitectura · clic para ampliar</div>
  </div>

</div>

<footer>
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
    <span class="fc">© 2026 Alejandro Rodríguez Calabuig</span>
    <span class="fc" style="font-size:11px;color:var(--t4)" data-es="Construido con Astro · Deploy en Vercel" data-en="Built with Astro · Deployed on Vercel">Construido con Astro · Deploy en Vercel</span>
  </div>
</footer>

<script>
  const ES='es', EN='en';
  let current = localStorage.getItem('lang') || ES;
  const btnEs  = document.getElementById('btn-es');
  const btnEn  = document.getElementById('btn-en');
  const btnEsM = document.getElementById('btn-es-m');
  const btnEnM = document.getElementById('btn-en-m');

  function applyLang(lang) {
    current = lang;
    localStorage.setItem('lang', lang);
    [btnEs, btnEsM].forEach(b => { if(b) b.className = lang===ES ? 'i18n-active' : 'i18n-inactive'; });
    [btnEn, btnEnM].forEach(b => { if(b) b.className = lang===EN ? 'i18n-active' : 'i18n-inactive'; });
    document.getElementById('html-root').lang = lang===ES ? 'es' : 'en';
    document.querySelectorAll('[data-es]').forEach(el => {
      const t = el.getAttribute('data-' + lang);
      if(t) el.innerHTML = t;
    });
  }
  btnEs.addEventListener('click', () => applyLang(ES));
  btnEn.addEventListener('click', () => applyLang(EN));
  btnEsM.addEventListener('click', () => applyLang(ES));
  btnEnM.addEventListener('click', () => applyLang(EN));

  const hamburger = document.getElementById('nav-hamburger');
  const navMobile = document.getElementById('nav-mobile');
  const mainNav   = document.getElementById('main-nav');

  function openMenu() {
    navMobile.style.top = mainNav.getBoundingClientRect().bottom + 'px';
    navMobile.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    hamburger.querySelector('i').className = 'ti ti-x';
  }
  function closeMenu() {
    navMobile.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    hamburger.querySelector('i').className = 'ti ti-menu-2';
  }
  hamburger.addEventListener('click', () => navMobile.classList.contains('open') ? closeMenu() : openMenu());
  window.addEventListener('scroll', () => {
    if(navMobile.classList.contains('open')) navMobile.style.top = mainNav.getBoundingClientRect().bottom + 'px';
  }, { passive: true });
  navMobile.querySelectorAll('a').forEach(l => l.addEventListener('click', closeMenu));

  applyLang(current);
</script>
</body>
</html>