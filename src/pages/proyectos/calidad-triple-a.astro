---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="es" id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Calidad Triple A · ArocaDev</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  <style>
    /* LIGHTBOX */
    .lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.92);z-index:1000;align-items:center;justify-content:center;cursor:zoom-out}
    .lightbox.open{display:flex}
    .lightbox img{max-width:92vw;max-height:90vh;border-radius:8px;object-fit:contain;margin:auto}
    .lightbox-close{position:absolute;top:20px;right:28px;color:#fff;font-size:32px;cursor:pointer;line-height:1;z-index:1001}

    /* DIAGRAMAS */
    .diagram-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .diagram-item{border-radius:8px;overflow:hidden;cursor:pointer;border:1px solid rgba(255,255,255,0.07);background:#fff;padding:8px}
    .diagram-item object{width:100%;display:block;pointer-events:none;border-radius:4px}
    .diagram-item span{display:block;font-size:11px;color:#888;padding:6px 2px 0}

    /* GIF */
    .gif-container{position:relative;border-radius:8px;overflow:hidden;border:1px solid rgba(255,255,255,0.07);background:var(--bg2);cursor:pointer}
    .gif-container img{width:100%;display:block;border-radius:8px}
    .gif-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;border-radius:8px;transition:opacity 0.2s}
    .gif-overlay.hidden{opacity:0;pointer-events:none}
    .gif-play-btn{width:64px;height:64px;border-radius:50%;background:rgba(129,140,248,0.9);display:flex;align-items:center;justify-content:center}
    .gif-play-btn i{font-size:28px;color:#fff;margin-left:4px}
    .gif-label{font-size:11px;color:var(--t4);margin-top:8px}
    .pdf-note{background:rgba(129,140,248,0.06);border:1px solid rgba(129,140,248,0.15);border-radius:8px;padding:14px 18px;font-size:12px;color:var(--t3);line-height:1.7;margin-top:10px}
    .pdf-note b{color:var(--t2)}

    /* CAPTURAS - CAROUSEL */
    .carousel{position:relative;display:flex;align-items:center;gap:10px}
    .carousel-track{flex:1;overflow:hidden;border-radius:8px;border:1px solid rgba(255,255,255,0.07);background:var(--bg2)}
    .carousel-slide{display:none;flex-direction:column}
    .carousel-slide.active{display:flex}
    .carousel-slide img{width:100%;display:block;cursor:pointer}
    .carousel-slide span{font-size:11px;color:var(--t4);padding:8px 12px}
    .carousel-btn{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:var(--t2);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background 0.2s}
    .carousel-btn:hover{background:rgba(255,255,255,0.12)}
    .carousel-dots{display:flex;justify-content:center;gap:6px;margin-top:10px}
    .dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,0.15);cursor:pointer;transition:background 0.2s}
    .dot.active{background:var(--ac)}
  </style>
</head>
<body>
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">aroca<span>.dev</span></a>
    <div class="nav-r">
      <div class="nav-links">
        <a href="/#sobre-mi" data-es="sobre mí" data-en="about">sobre mí</a>
        <a href="/#proyectos" data-es="proyectos" data-en="projects">proyectos</a>
        <a href="/#experiencia" data-es="experiencia" data-en="experience">experiencia</a>
        <a href="/#contacto" data-es="contacto" data-en="contact">contacto</a>
      </div>
      <div class="i18n">
        <span class="i18n-btn" id="btn-es">ES</span>
        <span class="i18n-sep">|</span>
        <span class="i18n-btn" id="btn-en">EN</span>
      </div>
    </div>
  </div>
</nav>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox">
  <span class="lightbox-close" id="lightbox-close">×</span>
  <img id="lightbox-img" src="" alt="" />
</div>

<div class="proj-hero">
  <div class="proj-category" data-es="Proyecto freelance · En producción" data-en="Freelance project · Live">Proyecto freelance · En producción</div>
  <div class="proj-title">Calidad Triple A</div>
  <div class="proj-subtitle" data-es="E-commerce para tienda de moda urbana y streetwear. Catálogo con CMS headless, checkout con cálculo de envíos, confirmación por WhatsApp y emails automáticos con PDF y QR. El pago se gestiona manualmente por Bizum y PayPal. Implementación completa: desarrollo, DNS, dominio y despliegue en Vercel." data-en="E-commerce for an urban fashion and streetwear shop. Headless CMS catalogue, checkout with shipping calculation, WhatsApp confirmation and automatic emails with PDF and QR. Payments managed manually via Bizum and PayPal. Full implementation: development, DNS, domain and deployment on Vercel.">E-commerce para tienda de moda urbana y streetwear. Catálogo con CMS headless, checkout con cálculo de envíos, confirmación por WhatsApp y emails automáticos con PDF y QR. El pago se gestiona manualmente por Bizum y PayPal. Implementación completa: desarrollo, DNS, dominio y despliegue en Vercel.</div>
  <div class="proj-links">
    <a href="https://www.calidad3a.com" target="_blank" class="proj-link proj-link-web"><i class="ti ti-external-link"></i><span data-es="Ver web" data-en="Visit site">Ver web</span></a>
  </div>
</div>

<div class="proj-body">

  <div class="proj-section">
    <div style="font-size:11px;color:var(--t4);margin-bottom:20px;display:flex;align-items:center;gap:6px"><i class="ti ti-lock" style="font-size:12px;color:var(--t4)"></i><span data-es="Repositorio privado — el código pertenece al cliente. Si quieres verlo, puedes contactarme directamente." data-en="Private repository — the code belongs to the client. If you'd like to see it, feel free to contact me directly.">Repositorio privado — el código pertenece al cliente. Si quieres verlo, puedes contactarme directamente.</span></div>
    <div class="proj-section-title" data-es="El problema" data-en="The problem">El problema</div>
    <div class="proj-text">
      <p data-es="El cliente necesitaba una tienda online para vender moda urbana y streetwear, pero las soluciones estándar como Shopify o WooCommerce no encajaban: el modelo de negocio funciona con pago por Bizum o PayPal gestionado manualmente, y cada pedido requería generar documentación personalizada para el envío." data-en="The client needed an online store to sell urban and streetwear fashion, but standard solutions like Shopify or WooCommerce didn't fit: the business model works with Bizum or PayPal payments managed manually, and each order required generating custom shipping documentation.">El cliente necesitaba una tienda online para vender moda urbana y streetwear, pero las soluciones estándar como Shopify o WooCommerce no encajaban: el modelo de negocio funciona con pago por Bizum o PayPal gestionado manualmente, y cada pedido requería generar documentación personalizada para el envío.</p>
      <p data-es="El cliente tenía que poder gestionar el catálogo de forma completamente autónoma — añadir productos, cambiar precios, subir imágenes — sin tocar código ni depender de un desarrollador para el día a día." data-en="The client needed to manage the catalogue completely autonomously — add products, change prices, upload images — without touching code or depending on a developer for day-to-day tasks.">El cliente tenía que poder gestionar el catálogo de forma completamente autónoma — añadir productos, cambiar precios, subir imágenes — sin tocar código ni depender de un desarrollador para el día a día.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="La solución" data-en="The solution">La solución</div>
    <div class="proj-text">
      <p data-es="E-commerce completo con arquitectura <b>JAMstack</b>: <b>Next.js 15</b> con App Router en el frontend y <b>Sanity CMS</b> como backend de contenido headless. El cliente gestiona el catálogo desde Sanity Studio sin tocar código." data-en="Full e-commerce with <b>JAMstack</b> architecture: <b>Next.js 15</b> with App Router on the frontend and <b>Sanity CMS</b> as a headless content backend. The client manages the catalogue from Sanity Studio without touching code.">E-commerce completo con arquitectura <b>JAMstack</b>: <b>Next.js 15</b> con App Router en el frontend y <b>Sanity CMS</b> como backend de contenido headless. El cliente gestiona el catálogo desde Sanity Studio sin tocar código.</p>
      <p data-es="El catálogo tiene tres categorías con filtros avanzados por subcategoría, marca, talla, género y precio. El carrito persiste con <b>Zustand</b> y el checkout calcula automáticamente los gastos de envío por país, con envío gratis en España a partir de 60€." data-en="The catalogue has three categories with advanced filters by subcategory, brand, size, gender and price. The cart persists with <b>Zustand</b> and checkout automatically calculates shipping costs by country, with free shipping in Spain from €60.">El catálogo tiene tres categorías con filtros avanzados por subcategoría, marca, talla, género y precio. El carrito persiste con <b>Zustand</b> y el checkout calcula automáticamente los gastos de envío por país, con envío gratis en España a partir de 60€.</p>
      <p data-es="El diseño visual — logotipo, paleta e identidad de marca — fue definido por el cliente. Mi trabajo fue la implementación técnica completa y la arquitectura del proyecto." data-en="The visual design — logo, palette and brand identity — was defined by the client. My work was the complete technical implementation and project architecture.">El diseño visual — logotipo, paleta e identidad de marca — fue definido por el cliente. Mi trabajo fue la implementación técnica completa y la arquitectura del proyecto.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Stack y detalles" data-en="Stack and details">Stack y detalles</div>
    <div class="meta-grid">
      <div class="sidebar-card">
        <div class="sidebar-label" data-es="Stack técnico" data-en="Tech stack">Stack técnico</div>
        <div class="sidebar-stack">
          <span class="about-tech-tag">Next.js 15</span><span class="about-tech-tag">TypeScript</span><span class="about-tech-tag">Sanity CMS</span><span class="about-tech-tag">Zustand</span><span class="about-tech-tag">Resend</span><span class="about-tech-tag">jsPDF</span><span class="about-tech-tag">Vercel</span>
        </div>
      </div>
      <div class="sidebar-card">
        <div class="sidebar-label" data-es="Detalles" data-en="Details">Detalles</div>
        <div class="sidebar-detail">
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Tipo" data-en="Type">Tipo</span><span class="sidebar-row-val">Freelance</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Año" data-en="Year">Año</span><span class="sidebar-row-val" data-es="2025 – hoy" data-en="2025 – present">2025 – hoy</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label" data-es="Estado" data-en="Status">Estado</span><span class="sidebar-row-val" data-es="En producción" data-en="Live">En producción</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label">Web</span><span class="sidebar-row-val">calidad3a.com</span></div>
          <div class="sidebar-row"><span class="sidebar-row-label"><i class="ti ti-lock" style="font-size:11px"></i></span><span class="sidebar-row-val" style="color:var(--t4);font-size:11px" data-es="Repo privado — código del cliente" data-en="Private repo — client code">Repo privado — código del cliente</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Lo que aprendí" data-en="What I learned">Lo que aprendí</div>
    <div class="proj-text">
      <p data-es="Este fue el proyecto donde más trabajé la comunicación con un cliente real: traducir necesidades de negocio a decisiones técnicas y gestionar entregas y ajustes en producción." data-en="This was the project where I worked most on communication with a real client: translating business needs into technical decisions and managing deliveries and adjustments in production.">Este fue el proyecto donde más trabajé la comunicación con un cliente real: traducir necesidades de negocio a decisiones técnicas y gestionar entregas y ajustes en producción.</p>
      <p data-es="También aprendí a configurar todo el stack de emails transaccionales desde cero — DNS, SPF, DKIM, verificación de dominio — para que los emails lleguen a bandeja de entrada." data-en="I also learned to configure the full transactional email stack from scratch — DNS, SPF, DKIM, domain verification — so emails actually reach the inbox.">También aprendí a configurar todo el stack de emails transaccionales desde cero — DNS, SPF, DKIM, verificación de dominio — para que los emails lleguen a bandeja de entrada.</p>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="¿Qué haría diferente hoy?" data-en="What I'd do differently today">¿Qué haría diferente hoy?</div>
    <div class="proj-text">
      <ul class="proj-list">
        <li data-es="Añadiría una pasarela de pago real (Stripe) desde el principio en lugar del flujo manual con Bizum/PayPal." data-en="I'd add a real payment gateway (Stripe) from the start instead of the manual Bizum/PayPal flow.">Añadiría una pasarela de pago real (Stripe) desde el principio en lugar del flujo manual con Bizum/PayPal.</li>
        <li data-es="Implementaría un panel de gestión de pedidos para el cliente en lugar de depender del email como único registro." data-en="I'd implement an order management panel for the client instead of relying on email as the only record.">Implementaría un panel de gestión de pedidos para el cliente en lugar de depender del email como único registro.</li>
        <li data-es="Añadiría tests de integración para el flujo de checkout y generación de documentos, que son las partes más críticas del negocio." data-en="I'd add integration tests for the checkout flow and document generation, which are the most business-critical parts.">Añadiría tests de integración para el flujo de checkout y generación de documentos, que son las partes más críticas del negocio.</li>
      </ul>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Diagramas" data-en="Diagrams">Diagramas</div>
    <div class="diagram-grid">
      <div class="diagram-item" onclick="window.open('/proyectos/calidad-triple-a/arquitectura.svg','_blank')" title="Abrir diagrama">
        <object data="/proyectos/calidad-triple-a/arquitectura.svg" type="image/svg+xml"></object>
        <span data-es="Arquitectura del sistema · clic para ampliar" data-en="System architecture · click to enlarge">Arquitectura del sistema · clic para ampliar</span>
      </div>
      <div class="diagram-item" onclick="window.open('/proyectos/calidad-triple-a/flujo-pedido.svg','_blank')" title="Abrir diagrama">
        <object data="/proyectos/calidad-triple-a/flujo-pedido.svg" type="image/svg+xml"></object>
        <span data-es="Flujo de pedido · clic para ampliar" data-en="Order flow · click to enlarge">Flujo de pedido · clic para ampliar</span>
      </div>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Flujo de compra" data-en="Purchase flow">Flujo de compra</div>
    <div class="gif-container" id="gif-container">
      <img id="gif-img" src="/proyectos/calidad-triple-a/demo-still.png" data-gif="/proyectos/calidad-triple-a/demo.gif" data-still="/proyectos/calidad-triple-a/demo-still.png" alt="Flujo de compra" />
      <div class="gif-overlay" id="gif-overlay">
        <div class="gif-play-btn"><i class="ti ti-player-play-filled"></i></div>
      </div>
    </div>
    <div class="gif-label" data-es="Pulsa para reproducir · Pulsa de nuevo para pausar" data-en="Click to play · Click again to pause">Pulsa para reproducir · Pulsa de nuevo para pausar</div>
    <div class="pdf-note" style="margin-top:12px">
      <b data-es="Tras confirmar el pedido" data-en="After order confirmation">Tras confirmar el pedido</b><br>
      <span data-es="El sistema genera automáticamente un PDF con el resumen del pedido, un PDF de datos de envío (150×100mm) y un código QR, que se envían adjuntos al email del vendedor vía Resend." data-en="The system automatically generates a PDF order summary, a shipping data PDF (150×100mm) and a QR code, all sent as attachments to the seller's email via Resend.">El sistema genera automáticamente un PDF con el resumen del pedido, un PDF de datos de envío (150×100mm) y un código QR, que se envían adjuntos al email del vendedor vía Resend.</span>
    </div>
  </div>

  <div class="proj-section">
    <div class="proj-section-title" data-es="Capturas" data-en="Screenshots">Capturas</div>
    <div style="font-size:11px;color:var(--t4);margin-bottom:10px" data-es="Usa las flechas para navegar. Haz clic en la imagen para verla completa." data-en="Use the arrows to browse. Click the image to view full size.">Usa las flechas para navegar. Haz clic en la imagen para verla completa.</div>
    <div class="carousel">
      <button class="carousel-btn carousel-prev" id="carousel-prev"><i class="ti ti-chevron-left"></i></button>
      <div class="carousel-track" id="carousel-track">
        <div class="carousel-slide active">
          <img src="/proyectos/calidad-triple-a/catalogo.png" alt="Catálogo" onclick="window.open(this.src,'_blank')" />
          <span data-es="Catálogo — 15 productos" data-en="Catalogue — 15 products">Catálogo — 15 productos</span>
        </div>
        <div class="carousel-slide">
          <img src="/proyectos/calidad-triple-a/ficha-producto.png" alt="Ficha de producto" onclick="window.open(this.src,'_blank')" />
          <span data-es="Ficha de producto" data-en="Product page">Ficha de producto</span>
        </div>
        <div class="carousel-slide">
          <img src="/proyectos/calidad-triple-a/carrito.png" alt="Carrito" onclick="window.open(this.src,'_blank')" />
          <span data-es="Carrito" data-en="Cart">Carrito</span>
        </div>
        <div class="carousel-slide">
          <img src="/proyectos/calidad-triple-a/checkout.png" alt="Checkout" onclick="window.open(this.src,'_blank')" />
          <span data-es="Checkout con envío gratis aplicado" data-en="Checkout with free shipping">Checkout con envío gratis aplicado</span>
        </div>
      </div>
      <button class="carousel-btn carousel-next" id="carousel-next"><i class="ti ti-chevron-right"></i></button>
    </div>
    <div class="carousel-dots" id="carousel-dots">
      <span class="dot active" onclick="goToSlide(0)"></span>
      <span class="dot" onclick="goToSlide(1)"></span>
      <span class="dot" onclick="goToSlide(2)"></span>
      <span class="dot" onclick="goToSlide(3)"></span>
    </div>
  </div>

</div>

<footer><span class="fc">© 2026 Alejandro Rodríguez Calabuig</span></footer>

<script>
  // CAROUSEL
  let currentSlide = 0;
  const slides = document.querySelectorAll('.carousel-slide');
  const dots = document.querySelectorAll('.dot');
  function goToSlide(n) {
    slides[currentSlide].classList.remove('active');
    dots[currentSlide].classList.remove('active');
    currentSlide = (n + slides.length) % slides.length;
    slides[currentSlide].classList.add('active');
    dots[currentSlide].classList.add('active');
  }
  document.getElementById('carousel-prev').addEventListener('click', () => goToSlide(currentSlide - 1));
  document.getElementById('carousel-next').addEventListener('click', () => goToSlide(currentSlide + 1));

  // LIGHTBOX
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img');
  function openLightbox(src) {
    lbImg.src = src;
    lb.classList.add('open');
  }
  lb.addEventListener('click', () => lb.classList.remove('open'));
  document.getElementById('lightbox-close').addEventListener('click', (e) => { e.stopPropagation(); lb.classList.remove('open'); });

  // GIF PLAY/PAUSE
  let gifPlaying = false;
  document.getElementById('gif-container').addEventListener('click', function() {
    const img = document.getElementById('gif-img');
    const overlay = document.getElementById('gif-overlay');
    if (!gifPlaying) {
      const gifSrc = img.getAttribute('data-gif');
      img.src = gifSrc + '?t=' + Date.now();
      overlay.classList.add('hidden');
      gifPlaying = true;
    } else {
      img.src = img.getAttribute('data-still');
      overlay.classList.remove('hidden');
      gifPlaying = false;
    }
  });

  // I18N
  const ES='es',EN='en';
  let current=localStorage.getItem('lang')||ES;
  const btnEs=document.getElementById('btn-es'),btnEn=document.getElementById('btn-en');
  function applyLang(lang){current=lang;localStorage.setItem('lang',lang);btnEs.className=lang===ES?'i18n-active':'i18n-inactive';btnEn.className=lang===EN?'i18n-active':'i18n-inactive';document.getElementById('html-root').lang=lang===ES?'es':'en';document.querySelectorAll('[data-es]').forEach(el=>{const t=el.getAttribute(`data-${lang}`);if(t)el.innerHTML=t;});}
  btnEs.addEventListener('click',()=>applyLang(ES));btnEn.addEventListener('click',()=>applyLang(EN));
  applyLang(current);
</script>
</body>
</html>