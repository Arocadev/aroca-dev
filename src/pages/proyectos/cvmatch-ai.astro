<script>
  // GIFs
  function makeGif(containerId, imgId, overlayId) {
    document.getElementById(containerId).addEventListener('click', function() {
      const img = document.getElementById(imgId);
      const overlay = document.getElementById(overlayId);
      if (overlay.classList.contains('hidden')) {
        img.src = img.getAttribute('data-still');
        overlay.classList.remove('hidden');
      } else {
        img.src = img.getAttribute('data-gif') + '?t=' + Date.now();
        overlay.classList.add('hidden');
      }
    });
  }
  makeGif('gif-buscador','gif-buscador-img','gif-buscador-overlay');
  makeGif('gif-buscador-ia','gif-buscador-ia-img','gif-buscador-ia-overlay');
  makeGif('gif-compatibilidad','gif-compatibilidad-img','gif-compatibilidad-overlay');
  makeGif('gif-generar-cv','gif-generar-cv-img','gif-generar-cv-overlay');
  makeGif('gif-crear-cv','gif-crear-cv-img','gif-crear-cv-overlay');

  // CAROUSEL PDF
  let pdfSlide = 0;
  const pdfSlides = document.querySelectorAll('#pdf-track .carousel-slide');
  const pdfDots = document.querySelectorAll('#pdf-dots .dot');
  function goToPdfSlide(n) {
    pdfSlides[pdfSlide].classList.remove('active'); pdfDots[pdfSlide].classList.remove('active');
    pdfSlide = (n + pdfSlides.length) % pdfSlides.length;
    pdfSlides[pdfSlide].classList.add('active'); pdfDots[pdfSlide].classList.add('active');
  }
  document.getElementById('pdf-prev').addEventListener('click', () => goToPdfSlide(pdfSlide - 1));
  document.getElementById('pdf-next').addEventListener('click', () => goToPdfSlide(pdfSlide + 1));

  // CAROUSEL CAPTURAS
  let scSlide = 0;
  const scSlides = document.querySelectorAll('#sc-track .carousel-slide');
  const scDots = document.querySelectorAll('#sc-dots .dot');
  function goToScSlide(n) {
    scSlides[scSlide].classList.remove('active'); scDots[scSlide].classList.remove('active');
    scSlide = (n + scSlides.length) % scSlides.length;
    scSlides[scSlide].classList.add('active'); scDots[scSlide].classList.add('active');
  }
  document.getElementById('sc-prev').addEventListener('click', () => goToScSlide(scSlide - 1));
  document.getElementById('sc-next').addEventListener('click', () => goToScSlide(scSlide + 1));

  // I18N
  const ES='es',EN='en';
  let current=localStorage.getItem('lang')||ES;
  const btnEs=document.getElementById('btn-es'),btnEn=document.getElementById('btn-en');
  function applyLang(lang){current=lang;localStorage.setItem('lang',lang);btnEs.className=lang===ES?'i18n-active':'i18n-inactive';btnEn.className=lang===EN?'i18n-active':'i18n-inactive';document.getElementById('html-root').lang=lang===ES?'es':'en';document.querySelectorAll('[data-es]').forEach(el=>{const t=el.getAttribute(`data-${lang}`);if(t)el.innerHTML=t;});}
  btnEs.addEventListener('click',()=>applyLang(ES));
  btnEn.addEventListener('click',()=>applyLang(EN));
  applyLang(current);
</script>
