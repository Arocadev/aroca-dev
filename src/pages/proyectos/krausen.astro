<script>
  let scSlide = 0;
  const scSlides = document.querySelectorAll('#sc-track .carousel-slide');
  const scDots = document.querySelectorAll('#sc-dots .dot');
  function goToScSlide(n) {
    scSlides[scSlide].classList.remove('active'); scDots[scSlide].classList.remove('active');
    scSlide = (n + scSlides.length) % scSlides.length;
    scSlides[scSlide].classList.add('active'); scDots[scSlide].classList.add('active');
  }
  document.getElementById('sc-prev').addEventListener('click', () => goToScSlide(scSlide - 1));
  document.getElementById('sc-next').addEventListener('click', () => goToScSlide(scSlide + 1));

  const ES='es', EN='en';
  let current = localStorage.getItem('lang') || ES;
  const btnEs  = document.getElementById('btn-es');
  const btnEn  = document.getElementById('btn-en');
  const btnEsM = document.getElementById('btn-es-m');
  const btnEnM = document.getElementById('btn-en-m');
  function applyLang(lang) {
    current = lang; localStorage.setItem('lang', lang);
    [btnEs, btnEsM].forEach(b => { if(b) b.className = lang===ES ? 'i18n-active' : 'i18n-inactive'; });
    [btnEn, btnEnM].forEach(b => { if(b) b.className = lang===EN ? 'i18n-active' : 'i18n-inactive'; });
    document.getElementById('html-root').lang = lang===ES ? 'es' : 'en';
    document.querySelectorAll('[data-es]').forEach(el => { const t = el.getAttribute('data-'+lang); if(t) el.innerHTML = t; });
  }
  btnEs.addEventListener('click', () => applyLang(ES));
  btnEn.addEventListener('click', () => applyLang(EN));
  btnEsM.addEventListener('click', () => applyLang(ES));
  btnEnM.addEventListener('click', () => applyLang(EN));

  const hamburger = document.getElementById('nav-hamburger');
  const navMobile = document.getElementById('nav-mobile');
  const mainNav   = document.getElementById('main-nav');
  function openMenu() { navMobile.style.top = mainNav.getBoundingClientRect().bottom + 'px'; navMobile.classList.add('open'); hamburger.setAttribute('aria-expanded','true'); hamburger.querySelector('i').className='ti ti-x'; }
  function closeMenu() { navMobile.classList.remove('open'); hamburger.setAttribute('aria-expanded','false'); hamburger.querySelector('i').className='ti ti-menu-2'; }
  hamburger.addEventListener('click', () => navMobile.classList.contains('open') ? closeMenu() : openMenu());
  window.addEventListener('scroll', () => { if(navMobile.classList.contains('open')) navMobile.style.top = mainNav.getBoundingClientRect().bottom + 'px'; }, { passive: true });
  navMobile.querySelectorAll('a').forEach(l => l.addEventListener('click', closeMenu));

  applyLang(current);
</script>
</body>
</html>