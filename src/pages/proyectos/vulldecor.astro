    <span class="fc" style="font-size:11px;color:var(--t4)" data-es="Construido con Astro · Deploy en Vercel" data-en="Built with Astro · Deployed on Vercel">Construido con Astro · Deploy en Vercel</span>
  </div>
</footer>

<script>
  // LIGHTBOX
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img');
  lb.addEventListener('click', () => lb.classList.remove('open'));
  document.getElementById('lightbox-close').addEventListener('click', (e) => { e.stopPropagation(); lb.classList.remove('open'); });

  // GIF WEB
  let gifWebPlaying = false;
  document.getElementById('gif-web').addEventListener('click', function() {
    const img = document.getElementById('gif-web-img');
    const overlay = document.getElementById('gif-web-overlay');
    if (!gifWebPlaying) { img.src = img.getAttribute('data-gif') + '?t=' + Date.now(); overlay.classList.add('hidden'); gifWebPlaying = true; }
    else { img.src = img.getAttribute('data-still'); overlay.classList.remove('hidden'); gifWebPlaying = false; }
  });

  // GIF APP
  let gifAppPlaying = false;
  document.getElementById('gif-app').addEventListener('click', function() {
    const img = document.getElementById('gif-app-img');
    const overlay = document.getElementById('gif-app-overlay');
    if (!gifAppPlaying) { img.src = img.getAttribute('data-gif') + '?t=' + Date.now(); overlay.classList.add('hidden'); gifAppPlaying = true; }
    else { img.src = img.getAttribute('data-still'); overlay.classList.remove('hidden'); gifAppPlaying = false; }
  });

  // CAROUSEL WEB
  let webSlide = 0;
  const webSlides = document.querySelectorAll('#web-prev')[0].closest('.proj-section').querySelectorAll('.carousel-slide');
  const webDots = document.querySelectorAll('#web-dots .dot');
  function goToWebSlide(n) {
    webSlides[webSlide].classList.remove('active'); webDots[webSlide].classList.remove('active');
    webSlide = (n + webSlides.length) % webSlides.length;
    webSlides[webSlide].classList.add('active'); webDots[webSlide].classList.add('active');
  }
  document.getElementById('web-prev').addEventListener('click', () => goToWebSlide(webSlide - 1));
  document.getElementById('web-next').addEventListener('click', () => goToWebSlide(webSlide + 1));

  // CAROUSEL APP
  let appSlide = 0;
  const appSlides = document.querySelectorAll('#app-prev')[0].closest('.proj-section').querySelectorAll('.carousel-slide');
  const appDots = document.querySelectorAll('#app-dots .dot');
  function goToAppSlide(n) {
    appSlides[appSlide].classList.remove('active'); appDots[appSlide].classList.remove('active');
    appSlide = (n + appSlides.length) % appSlides.length;
    appSlides[appSlide].classList.add('active'); appDots[appSlide].classList.add('active');
  }
  document.getElementById('app-prev').addEventListener('click', () => goToAppSlide(appSlide - 1));
  document.getElementById('app-next').addEventListener('click', () => goToAppSlide(appSlide + 1));

  // I18N
  const ES='es',EN='en';
  let current=localStorage.getItem('lang')||ES;
  const btnEs=document.getElementById('btn-es'),btnEn=document.getElementById('btn-en');
  function applyLang(lang){current=lang;localStorage.setItem('lang',lang);btnEs.className=lang===ES?'i18n-active':'i18n-inactive';btnEn.className=lang===EN?'i18n-active':'i18n-inactive';document.getElementById('html-root').lang=lang===ES?'es':'en';document.querySelectorAll('[data-es]').forEach(el=>{const t=el.getAttribute(`data-${lang}`);if(t)el.innerHTML=t;});}
  btnEs.addEventListener('click',()=>applyLang(ES));btnEn.addEventListener('click',()=>applyLang(EN));
  applyLang(current);
</script>
</body>
</html>