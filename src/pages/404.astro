---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es" id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 · Página no encontrada | aroca.dev</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
</head>
<body>
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">aroca<span>.dev</span></a>
  </div>
</nav>

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:80vh;text-align:center;padding:24px">
  <div style="font-family:'Space Grotesk',sans-serif;font-size:96px;font-weight:800;color:var(--ac);letter-spacing:-4px;line-height:1;margin-bottom:16px">404</div>
  <div style="font-family:'Space Grotesk',sans-serif;font-size:22px;font-weight:600;color:var(--t2);margin-bottom:12px">Página no encontrada</div>
  <div style="font-size:14px;color:var(--t4);margin-bottom:36px;max-width:360px;line-height:1.7">Esta página no existe o ha sido movida. Vuelve al inicio para encontrar lo que buscas.</div>
  <a href="/" style="display:inline-flex;align-items:center;gap:8px;padding:0 24px;height:46px;border-radius:10px;font-size:14px;font-weight:600;background:var(--ac);color:#05061a;text-decoration:none">
    <i class="ti ti-arrow-left" aria-hidden="true"></i>
    Volver al inicio
  </a>
</div>

<footer>
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
    <span class="fc">© 2026 Alejandro Rodríguez Calabuig</span>
  </div>
</footer>
</body>
</html>